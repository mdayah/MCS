    CLOSE
    OPEN "..\DataFile\Config.Mas" FOR OUTPUT AS #1
    WRITE #1, StoNum  'Store number
    WRITE #1, AgrNum  'Agreement Number
    WRITE #1, RctNum  'Receipt Number
    WRITE #1, RptDay  'Recap report day
    WRITE #1, EndBak  'Last backup        date
    WRITE #1, EndDay  'Last day   closing date
    WRITE #1, EndWek  'Last week  closing date
    WRITE #1, EndMon  'Last month closing date
    WRITE #1, EndYer  'Last year  closing date
'   CALL Clock(0)
    CLOSE

